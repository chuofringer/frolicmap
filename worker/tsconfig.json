{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // shared/osm.ts imports ./url.ts with its extension so plain Node can load it; `tsc --noEmit` only.
    "allowImportingTsExtensions": true,
    "paths": {
      "@shared/*": ["../shared/*"]
    }
  },
  "include": ["src/**/*", "../shared/**/*"],
  // `shared/__tests__` runs under the frontend Vitest project (it reads
  // `public/` off disk via node:fs). The worker build has no node types, so
  // sweeping those files in here would fail typecheck for no benefit.
  "exclude": ["../shared/**/__tests__/**"]
}
