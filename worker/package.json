{
  "name": "frolicmap-api",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create frolicmap-prod",
    "db:migrate": "wrangler d1 migrations apply frolicmap-prod --remote",
    "db:migrate:local": "wrangler d1 migrations apply frolicmap-prod --local",
    "test": "vitest",
    "test:run": "vitest run",
    "test:mjs": "node --test test/dedupCluster.test.mjs test/ingest-osm-national.test.mjs test/name-waterplay.test.mjs test/normalizeAddress.test.mjs test/wranglerExec.test.mjs test/migrationNumbers.test.mjs test/import-funradar.test.mjs"
  },
  "dependencies": {
    "geojson-vt": "^5.0.4",
    "hono": "^4.13.13",
    "parse-address": "^1.1.2",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/geojson-vt": "^3.2.5",
    "@types/vt-pbf": "^3.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "4.151.1"
  }
}
