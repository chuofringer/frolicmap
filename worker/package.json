{
  "name": "frolicmap-api",
  "description": "Read-only Cloudflare Worker API (items, vector tiles, session) for frolicmap.app, plus offline import and SEO scripts.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuofringer/frolicmap.git"
  },
  "homepage": "https://frolicmap.app",
  "bugs": {
    "url": "https://github.com/chuofringer/frolicmap/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create frolicmap-prod",
    "db:migrate": "wrangler d1 migrations apply frolicmap-prod --remote",
    "db:migrate:local": "wrangler d1 migrations apply frolicmap-prod --local",
    "test": "vitest",
    "test:run": "vitest run",
    "test:mjs": "node --test test/dedupCluster.test.mjs test/ingest-osm-national.test.mjs test/name-waterplay.test.mjs test/normalizeAddress.test.mjs test/wranglerExec.test.mjs test/migrationNumbers.test.mjs test/citiesThumbs.test.mjs test/export-odbl.test.mjs"
  },
  "dependencies": {
    "geojson-vt": "^4.0.2",
    "hono": "^4.12.14",
    "parse-address": "^1.1.2",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.7",
    "@cloudflare/workers-types": "^4.20260430.1",
    "@types/geojson-vt": "^3.2.5",
    "@types/vt-pbf": "^3.1.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.12",
    "wrangler": "4.87.0"
  }
}
