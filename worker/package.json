{
  "name": "frolicmap-api",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create frolicmap-prod",
    "db:migrate": "wrangler d1 migrations apply frolicmap-prod --remote",
    "db:migrate:local": "wrangler d1 migrations apply frolicmap-prod --local",
    "test": "vitest",
    "test:run": "vitest run",
    "test:mjs": "node --test test/dedupCluster.test.mjs test/ingest-osm-national.test.mjs test/name-waterplay.test.mjs test/normalizeAddress.test.mjs test/wranglerExec.test.mjs test/migrationNumbers.test.mjs"
  },
  "dependencies": {
    "geojson-vt": "^4.0.2",
    "hono": "^4.12.14",
    "jose": "^6.2.12",
    "parse-address": "^1.1.2",
    "vt-pbf": "^3.1.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.7",
    "@cloudflare/workers-types": "^4.20260430.1",
    "@types/geojson-vt": "^3.2.5",
    "@types/vt-pbf": "^3.1.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4",
    "wrangler": "4.87.0"
  }
}
