{
  "name": "frolicmap",
  "description": "Free, read-only map of kids activities (playgrounds, parks, libraries, museums, beaches, water play) for US metros.",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chuofringer/frolicmap.git"
  },
  "homepage": "https://frolicmap.app",
  "bugs": {
    "url": "https://github.com/chuofringer/frolicmap/issues"
  },
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "//seo": "Run AFTER build — needs dist/index.html as the SPA shell to rewrite for /map/*. Reads published metros from D1; --remote for prod data. The CI deploy chain is: build -> seo:remote -> apply data/seo/slug-assignments.sql -> wrangler pages deploy dist.",
    "seo": "node worker/scripts/build-seo-pages.mjs --out dist",
    "seo:remote": "node worker/scripts/build-seo-pages.mjs --remote --out dist",
    "build:seo": "npm run build && npm run seo:remote",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.99.0",
    "i18next": "^26.3.6",
    "maplibre-gl": "^6.15.0",
    "parse-address": "^1.1.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.11",
    "react-map-gl": "^8.1.3",
    "react-router-dom": "^7.14.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@tailwindcss/vite": "^4.2.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "jsdom": "^29.0.2",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.4",
    "workbox-cacheable-response": "^7.4.1",
    "workbox-core": "^7.4.1",
    "workbox-expiration": "^7.4.1",
    "workbox-precaching": "^7.4.1",
    "workbox-routing": "^7.4.1",
    "workbox-strategies": "^7.4.1"
  }
}
